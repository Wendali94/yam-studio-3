<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>YamStudio</AssemblyName>
    <RootNamespace>YamStudio</RootNamespace>
    <Version>2.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>CS1998;CS0219;CS0168;CS4014;CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="publish/**" />
    <Compile Remove="artifacts/**" />
    <!-- Ignore old PC1/PC2 files even if they were not deleted -->
    <Compile Remove="Ui/SetupWindow.cs" />
    <Compile Remove="Core/LanApi.cs" />
    <Compile Remove="Core/RemoteStudio.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
