<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>YamStudio</AssemblyName>
    <RootNamespace>YamStudio</RootNamespace>
    <Version>2.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>CS1998;CS0219;CS0168;CS4014;CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- the tests live in their own project; do not compile them into the app -->
    <Compile Remove="tests/**" />
    <Compile Remove="publish/**" />
    <Compile Remove="artifacts/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <!-- UseWPF removes System.IO from the implicit usings; put it back -->
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
